---
// Page shell: <head>, fonts, skip link. Every page renders inside it.
import '../styles/global.css';
import jost from '../assets/fonts/jost-latin-wght-normal.woff2?url';
import valiente from '../assets/fonts/ValienteDisplay-Light.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** Prefix for the header's in-page links: "" on the home page, "/" on pages served elsewhere (404) */
  linkBase?: string;
}

const { title = site.title, description = site.description, linkBase = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og.jpg`, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Prototype for the pitch: keep it out of search until the client approves a launch */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={site.themeColor} />

    <link rel="preload" href={jost} as="font" type="font/woff2" crossorigin />
    {/* The label face isn't preloaded (7.10): no phone shows it in its first view, so it would only
         compete with the hero. It loads when first used, with swap */}
    <link rel="preload" href={valiente} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
      <!-- Google Fonts: Instrument Serif, JetBrains Mono, Zen Kaku Gothic New -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a class="skip-link label" href="#contenido">Saltar al contenido</a>
    <Header linkBase={linkBase} />
    <slot />
    <Footer linkBase={linkBase} />
  </body>
</html>
