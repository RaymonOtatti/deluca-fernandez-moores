---
// Composition root: wires the content in src/content into the section components.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Estudio from '../components/Estudio.astro';
import Areas from '../components/Areas.astro';
import Servicios from '../components/Servicios.astro';
import Equipo from '../components/Equipo.astro';
import Asociaciones from '../components/Asociaciones.astro';
---
<Base>
  <main id="contenido">
    <Hero />
    <Estudio />
    <Areas />
    <Servicios />
    <Equipo />
    <Asociaciones />
  </main>
</Base>
