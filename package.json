{
  "name": "svya-mvp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "pnpm test:unit && pnpm test:build && node scripts/e2e.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:build": "pnpm build && node --experimental-strip-types --no-warnings --test tests/build/*.test.ts",
    "test:e2e": "pnpm build && node scripts/e2e.mjs",
    "serve": "pnpm build && node scripts/serve.mjs 4321",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "deploy": "pnpm test && npx --yes wrangler@4.145.0 deploy"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "sharp": "0.35.5"
  }
}
