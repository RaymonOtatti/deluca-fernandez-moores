{
  // Static assets only, no Worker script: every request is served straight from dist/ with the rules
  // in dist/_headers, and a missing path gets dist/404.html with a 404 status. Deploy: pnpm run deploy (plain "pnpm deploy" is a pnpm built-in).
  "name": "svya-mvp",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
